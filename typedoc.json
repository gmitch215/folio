{
	"$schema": "https://typedoc.org/schema.json",
	"entryPoints": [
		"src/index.ts",
		"src/node.ts",
		"src/compiler.ts",
		"src/remote.ts",
		"src/host.ts",
		"src/managed.ts",
		"src/browser.ts",
		"src/pages.ts",
		"src/tasks.ts",
		"src/context.ts",
		"src/bake.ts"
	],
	"out": "typedoc",
	"cname": "folio.gmitch215.dev",
	"name": "@gmitch215/folio",
	"readme": "README.md",
	"projectDocuments": ["TECHNICAL_REPORT.md"],
	"includeVersion": true,
	"highlightLanguages": [
		"bash",
		"console",
		"css",
		"html",
		"javascript",
		"json",
		"jsonc",
		"json5",
		"tsx",
		"typescript",
		"php",
		"sh"
	],
	"excludeInternal": true,
	"excludePrivate": true,
	"validation": {
		"notExported": true,
		"invalidLink": true,
		"notDocumented": true
	},
	"treatWarningsAsErrors": false
}

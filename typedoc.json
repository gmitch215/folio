{
	"$schema": "https://typedoc.org/schema.json",
	"entryPoints": [
		"src/index.ts",
		"src/workers.ts",
		"src/browser.ts",
		"src/memory.ts",
		"src/boot.ts",
		"src/continuation.ts"
	],
	"alwaysCreateEntryPointModule": false,
	"out": "typedoc",
	"name": "@gmitch215/folio",
	"readme": "README.md",
	"projectDocuments": [
		"docs/getting-started.md",
		"docs/modules/README.md",
		"docs/modules/core.md",
		"docs/modules/pools.md",
		"docs/modules/folds-and-certificates.md",
		"docs/modules/workers.md",
		"docs/modules/browser.md",
		"docs/modules/memory.md",
		"docs/modules/boot.md",
		"docs/modules/continuation.md",
		"docs/configuration.md",
		"docs/limits.md",
		"ADVANCED_USAGE.md",
		"docs/studies/README.md",
		"docs/studies/storage-resets.md",
		"docs/studies/continuation-across-events.md",
		"docs/studies/elastic-memory.md",
		"docs/studies/boot-images.md",
		"docs/studies/memory-accounting.md",
		"docs/studies/parallel-execution.md",
		"TECHNICAL_REPORT.md"
	],
	"favicon": "docs/favicon.ico",
	"customJs": "scripts/docs/render.js",
	"customCss": "scripts/docs/render.css",
	"includeVersion": true,
	"highlightLanguages": [
		"bash",
		"console",
		"css",
		"html",
		"javascript",
		"json",
		"jsonc",
		"json5",
		"tsx",
		"typescript",
		"php",
		"sh",
		"sql",
		"diff",
		"toml",
		"yaml"
	],
	"ignoredHighlightLanguages": ["mermaid", "math"],
	"locales": { "en": { "kind_plural_document": "Guides" } },
	"groupOrder": ["Guides", "*"],
	"navigation": { "includeGroups": true },
	"excludeInternal": true,
	"excludePrivate": true,
	"validation": {
		"notExported": true,
		"invalidLink": true,
		"notDocumented": true
	},
	"treatWarningsAsErrors": false
}

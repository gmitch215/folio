{
	"name": "cfw-folio-managed-probe",
	"main": "worker.ts",
	"compatibility_date": "2026-10-20",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": true,
	"durable_objects": {
		"bindings": [
			{ "name": "LANES", "class_name": "ManagedLane" },
			{ "name": "OWNERS", "class_name": "ManagedOwner" }
		]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["ManagedLane", "ManagedOwner"] }],
	"observability": { "enabled": true, "head_sampling_rate": 1 }
}

{
	"name": "cfw-folio-phases",
	"main": "worker.ts",
	"compatibility_date": "2026-10-29",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": true,
	"durable_objects": {
		"bindings": [
			{ "name": "LANES", "class_name": "PhaseLane" },
			{ "name": "OWNERS", "class_name": "PhaseOwner" }
		]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["PhaseLane", "PhaseOwner"] }],
	"observability": { "enabled": true, "head_sampling_rate": 1 }
}

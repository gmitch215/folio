{
	"name": "folio-bootimage-a",
	"main": "variants/a/worker.ts",
	"compatibility_date": "2026-10-20",
	"workers_dev": true,
	"durable_objects": { "bindings": [{ "name": "IMAGE", "class_name": "BootImage" }] },
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["BootImage"] }],
	"rules": [{ "type": "CompiledWasm", "globs": ["**/*.wasm"], "fallthrough": false }]
}

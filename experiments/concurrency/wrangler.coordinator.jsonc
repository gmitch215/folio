{
	"name": "cfw-folio-concurrency-coordinator",
	"main": "coordinator.ts",
	"compatibility_date": "2026-10-20",
	"workers_dev": true,
	"services": [
		{ "binding": "LANE1", "service": "cfw-folio-concurrency-lane" },
		{ "binding": "LANE2", "service": "cfw-folio-concurrency-lane" },
		{ "binding": "LANE3", "service": "cfw-folio-concurrency-lane" },
		{ "binding": "LANE4", "service": "cfw-folio-concurrency-lane" }
	],
	"durable_objects": {
		"bindings": [{ "name": "LANES", "class_name": "LaneObject" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["LaneObject"] }]
}

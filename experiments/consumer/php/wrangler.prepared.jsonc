{
	"name": "folio-consumer-prepared",
	"main": "prepared.ts",
	"compatibility_date": "2026-10-20",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": true,
	"durable_objects": { "bindings": [{ "name": "PHP", "class_name": "PhpProbe" }] },
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["PhpProbe"] }],
	"rules": [{ "type": "CompiledWasm", "globs": ["**/*.wasm"], "fallthrough": false }]
}

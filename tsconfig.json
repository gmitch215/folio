{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"lib": ["ES2022", "DOM"],
		"types": ["node"],
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,
		"noFallthroughCasesInSwitch": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"erasableSyntaxOnly": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"paths": {
			"@gmitch215/folio": ["./src/index.ts"],
			"@gmitch215/folio/*": ["./src/*.ts"]
		}
	},
	"include": [
		"src/**/*.ts",
		"tests/**/*.ts",
		"scripts/**/*.ts",
		"examples/**/*.ts",
		"experiments/**/*.ts",
		"vitest.config.ts"
	],
	"exclude": [
		"node_modules",
		"dist",
		"build",
		"coverage",
		"typedoc",
		"experiments/cloud/wasm.d.ts",
		"experiments/managed/wasm.d.ts",
		"experiments/bootimage/wasm.d.ts",
		"experiments/ranges/wasm.d.ts",
		"experiments/concurrency/wasm.d.ts",
		"experiments/concurrency/workerd.d.ts",
		"experiments/sqlite-lanes/wasm.d.ts",
		"experiments/sqlite-lanes/workerd.d.ts",
		"experiments/sqlite-lanes/coordinator.ts",
		"experiments/sqlite-lanes/queries.ts",
		"experiments/sqlite-lanes/sqlite.ts",
		"experiments/sqlite-lanes/prepare.ts",
		"experiments/sqlite-lanes/plan.ts",
		"experiments/sqlite-lanes/local.ts",
		"experiments/sqlite-lanes/run.ts",
		"experiments/concurrency/lane.ts",
		"experiments/concurrency/coordinator.ts",
		"experiments/concurrency/spin.ts",
		"experiments/corpus-lanes/wasm.d.ts",
		"experiments/corpus-lanes/workerd.d.ts",
		"experiments/corpus-lanes/coordinator.ts",
		"experiments/ranges/lane.ts",
		"experiments/ranges/coordinator.ts",
		"experiments/**/runs",
		"experiments/**/worker.ts",
		"experiments/**/artifact.ts",
		"experiments/browser/probe.ts",
		"experiments/consumer/php/prepared.ts"
	]
}

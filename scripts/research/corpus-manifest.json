		"numerical": "1024-point forward complex or real FFT; float[i] = ((i % 31) - 15) / 16",
		"aes": "AES-128; key=input[64:80], IV=input[96:112], 64 KiB input; decrypt input initialized by upstream encryption",
		"image": "128 by 128 RGBA, QOI sRGB; decoder input initialized by upstream encoder",
		"emulator": "6502 reset vector 0x0200, INX then JMP 0x0200, 65536 serial bus cycles"
	},

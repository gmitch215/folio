{
	"name": "@gmitch215/folio",
	"version": "1.0.0",
	"description": "Shared WASM memory and ordered speculative execution across isolates",
	"keywords": [
		"webassembly",
		"wasm",
		"parallel",
		"worker_threads",
		"sharedarraybuffer",
		"cloudflare-workers",
		"workerd"
	],
	"license": "MIT",
	"author": "Gregory Mitchell <me@gmitch215.xyz>",
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./node": {
			"types": "./dist/node.d.ts",
			"import": "./dist/node.js"
		},
		"./compiler": {
			"types": "./dist/compiler.d.ts",
			"import": "./dist/compiler.js"
		},
		"./remote": {
			"types": "./dist/remote.d.ts",
			"import": "./dist/remote.js"
		},
		"./host": {
			"types": "./dist/host.d.ts",
			"import": "./dist/host.js"
		},
		"./managed": {
			"types": "./dist/managed.d.ts",
			"import": "./dist/managed.js"
		},
		"./browser": {
			"types": "./dist/browser.d.ts",
			"import": "./dist/browser.js"
		},
		"./pages": {
			"types": "./dist/pages.d.ts",
			"import": "./dist/pages.js"
		},
		"./tasks": {
			"types": "./dist/tasks.d.ts",
			"import": "./dist/tasks.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"LICENSE",
		"README.md"
	],
	"engines": {
		"node": ">=26"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"build:c": "bun scripts/build/fixtures.ts",
		"build:prepared": "bun scripts/build/prepare.ts",
		"build:experiments": "node experiments/managed/prepare.ts && node experiments/browser/prepare.ts && node experiments/browser/extraction/prepare.ts && node experiments/consumer/prepare.ts kernel-control",
		"typecheck": "bun run build:c && bun run build:experiments && tsc --noEmit -p tsconfig.json && tsc --noEmit -p experiments/cloud/tsconfig.json && tsc --noEmit -p experiments/managed/tsconfig.json && tsc --noEmit -p experiments/browser/tsconfig.json && tsc --noEmit -p experiments/consumer/tsconfig.json",
		"typecheck:php": "node experiments/consumer/php/prepare.ts && tsc --noEmit -p experiments/consumer/php/tsconfig.json",
		"typecheck:bootimage": "node experiments/bootimage/prepare.ts && tsc --noEmit -p experiments/bootimage/tsconfig.json",
		"test": "vitest run --project unit",
		"test:watch": "vitest --project unit",
		"test:integration": "vitest run --project integration",
		"test:coverage": "vitest run --project unit --project integration --coverage",
		"test:report": "vitest run --project unit --project integration --coverage --reporter=default --reporter=junit --outputFile=test-report.junit.xml",
		"test:e2e": "vitest run --project e2e",
		"example": "node examples/basic.ts",
		"analyze": "bun scripts/analyze/run.ts",
		"docs:build": "typedoc",
		"docs:serve": "typedoc --watch",
		"prettier": "prettier --write .",
		"prettier:check": "prettier --check .",
		"prepare": "husky",
		"prepublishOnly": "bun run build"
	},
	"dependencies": {
		"binaryen": "132.0.0"
	},
	"devDependencies": {
		"@cloudflare/playwright": "1.3.6",
		"@cloudflare/workers-types": "^5.20260925.1",
		"@types/node": "^26.0.0",
		"@vitest/coverage-v8": "^5.0.1",
		"esbuild": "0.28.2",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"prettier": "^3.9.10",
		"prettier-plugin-organize-imports": "^4.3.0",
		"prettier-plugin-sh": "^0.20.2",
		"typedoc": "^0.28.20",
		"typescript": "^5.9.3",
		"vitest": "^5.0.1",
		"wrangler": "^4.139.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/gmitch215/folio.git"
	},
	"homepage": "https://github.com/gmitch215/folio",
	"bugs": {
		"url": "https://github.com/gmitch215/folio/issues"
	},
	"lint-staged": {
		"*.{ts,js,mjs,json,jsonc,md,yml,sh}": "prettier --write"
	}
}
